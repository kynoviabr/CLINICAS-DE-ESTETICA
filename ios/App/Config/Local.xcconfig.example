// Copie para Config/Local.xcconfig (ignorado pelo git) e ajuste.

// Seu Team da Apple (Xcode > Settings > Accounts > Team ID).
DEVELOPMENT_TEAM = XXXXXXXXXX

// Sufixo do bundle ID no Debug, para instalar no seu iPhone com um Team
// pessoal. Ex.: br.com.klinova.app.teste.seunome
BUNDLE_ID_SUFFIX = .teste.seunome
